# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Values come from the Supabase project dashboard: Settings -> API.
# Ask the Project Lead for the shared dev project credentials.

# --- Supabase (client-visible; safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER ONLY) ---
# Bypasses Row-Level Security. Must never appear in a NEXT_PUBLIC_* variable,
# in client components, or in any committed file.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
